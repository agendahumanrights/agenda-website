// Agenda — Prisma schema (Phase 1 foundation)
//
// Slug strategy (cookie-based i18n, no locale URL prefixes):
// - Each Publication and Event has one stable canonical `slug` (language-independent).
// - Public URLs: /publications/{slug} and /events/{slug} — same record in both languages.
// - Titles/subtitles/descriptions remain on *Translation tables; language comes from the cookie.
// - Lookups resolve by slug, then load the translation for the active locale.
//
// About Us content (vision/mission) is NOT managed via Admin (requirements §2.5).
// Founders power About Us biographies; Writers are independent publication authors.
//
// Migration note: If an earlier draft schema with per-translation slugs was applied,
// create a forward migration that adds Publication.slug / Event.slug, backfills from a
// preferred locale, drops translation.slug, and adds unique indexes. Do not run
// destructive resets against production data without a backup.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ar
  en
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

/// Admin-managed bilingual publication categories (replaces former enum).
model PublicationCategory {
  id             String   @id @default(cuid())
  /// Stable filter/URL key. Seeded legacy values: REPORT, BLOG, PAPER, BRIEFING.
  slug           String   @unique
  nameEn         String
  nameAr         String
  /// When true, publications require a writer author to publish.
  requiresAuthor Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  publications Publication[]

  @@unique([nameEn])
  @@unique([nameAr])
  @@index([sortOrder])
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum MediaKind {
  IMAGE
  PDF
  OTHER
}

/// Separate from public founder/author profiles. Used only for admin authentication.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
}

/// Opaque session: cookie holds the raw token; only SHA-256 hash is stored.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([adminUserId])
}

/// Persistent login throttling (shared across app instances).
model LoginThrottle {
  id              String    @id @default(cuid())
  /// e.g. "email:admin@example.com" or "ip:203.0.113.1"
  key             String    @unique
  failedCount     Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Public-facing founder profile (About Us). Independent from Writers.
model Founder {
  id        String   @id @default(cuid())
  /// Stable key for About Us deep links, e.g. "jane-doe" → /about#founder-jane-doe
  bioKey    String   @unique
  email     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileImageId String?     @unique
  profileImage   MediaAsset? @relation("FounderProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  translations FounderTranslation[]
}

/// Publication authors (independent from Founders). Public profile at /writers/{slug}.
model Writer {
  id        String   @id @default(cuid())
  /// Stable canonical slug for /writers/{slug}
  slug      String   @unique
  /// Optional so founder→writer migration can preserve incomplete legacy emails.
  email     String?
  /// JSON array of { platform: string, url: string } (no duplicates by platform).
  socialLinks Json   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileImageId String?     @unique
  profileImage   MediaAsset? @relation("WriterProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  translations WriterTranslation[]
  publicationAuthors PublicationWriter[]

  @@index([email])
}

model WriterTranslation {
  id       String @id @default(cuid())
  writerId String
  locale   Locale
  fullName String
  /// Optional professional specialization / major (empty string when unset).
  major    String
  /// Markdown biography; empty string allowed for legacy rows migrated without copy.
  biography String @default("") @db.Text

  writer Writer @relation(fields: [writerId], references: [id], onDelete: Cascade)

  @@unique([writerId, locale])
  @@index([locale])
}

model FounderTranslation {
  id               String @id @default(cuid())
  founderId        String
  locale           Locale
  fullName         String
  biography        String @db.Text
  professionalArea String

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([founderId, locale])
  @@index([locale])
}

model Publication {
  id              String            @id @default(cuid())
  /// Stable canonical slug for /publications/{slug} (shared across languages)
  slug            String            @unique
  categoryId      String
  status          PublicationStatus @default(DRAFT)
  /// Date shown to visitors
  publishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  mainImageId String?
  /// Optional English PDF attachment (locale-matched on public EN pages).
  pdfEnId     String? @unique
  /// Optional Arabic PDF attachment (locale-matched on public AR pages).
  pdfArId     String? @unique
  /// Optional single YouTube watch URL (canonical https://www.youtube.com/watch?v=…). Not counted toward image limits.
  youtubeUrl  String?

  category     PublicationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mainImage    MediaAsset?         @relation("PublicationMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  pdfEn        MediaAsset?         @relation("PublicationPdfEn", fields: [pdfEnId], references: [id], onDelete: SetNull)
  pdfAr        MediaAsset?         @relation("PublicationPdfAr", fields: [pdfArId], references: [id], onDelete: SetNull)
  translations PublicationTranslation[]
  gallery      PublicationGalleryImage[]
  /// Ordered writer authors (0–10). Required to publish when category.requiresAuthor.
  authors      PublicationWriter[]
  featured     FeaturedPublication?

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([mainImageId])
  @@index([pdfEnId])
  @@index([pdfArId])
}

/// Explicit many-to-many: publication ↔ writers with stable display order.
model PublicationWriter {
  id            String @id @default(cuid())
  publicationId String
  writerId      String
  /// 0-based display order on public surfaces.
  sortOrder     Int    @default(0)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  writer      Writer      @relation(fields: [writerId], references: [id], onDelete: Restrict)

  @@unique([publicationId, writerId])
  @@index([publicationId, sortOrder])
  @@index([writerId])
}

model PublicationTranslation {
  id            String @id @default(cuid())
  publicationId String
  locale        Locale
  title         String
  subtitle      String
  /// Markdown body
  description   String @db.Text

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, locale])
  @@index([locale, title])
}

model PublicationGalleryImage {
  id            String @id @default(cuid())
  publicationId String
  mediaAssetId  String
  sortOrder     Int    @default(0)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([publicationId, mediaAssetId])
  @@index([publicationId, sortOrder])
  @@index([mediaAssetId])
}

model Event {
  id        String      @id @default(cuid())
  /// Stable canonical slug for /events/{slug} (shared across languages)
  slug      String      @unique
  status    EventStatus @default(DRAFT)
  /// Occurrence date shown to visitors
  eventDate DateTime
  /// Record creation timestamp — used for public filtering (requirements §1.3)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  mainImageId String?
  /// Optional single YouTube watch URL (canonical https://www.youtube.com/watch?v=…). Not counted toward image limits.
  youtubeUrl  String?

  mainImage    MediaAsset?          @relation("EventMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  translations EventTranslation[]
  gallery      EventGalleryImage[]
  featured     FeaturedEvent?

  @@index([status, eventDate])
  @@index([createdAt])
  @@index([mainImageId])
}

model EventTranslation {
  id          String @id @default(cuid())
  eventId     String
  locale      Locale
  title       String
  subtitle    String
  /// Markdown body
  description String @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@index([locale, title])
}

model EventGalleryImage {
  id           String @id @default(cuid())
  eventId      String
  mediaAssetId String
  sortOrder    Int    @default(0)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([eventId, mediaAssetId])
  @@index([eventId, sortOrder])
  @@index([mediaAssetId])
}

model MediaAsset {
  id           String    @id @default(cuid())
  storageKey   String    @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  kind         MediaKind @default(OTHER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  altTexts MediaAltText[]

  founderProfile         Founder?                   @relation("FounderProfileImage")
  writerProfile          Writer?                    @relation("WriterProfileImage")
  publicationMainImages  Publication[]              @relation("PublicationMainImage")
  publicationPdfsEn      Publication[]              @relation("PublicationPdfEn")
  publicationPdfsAr      Publication[]              @relation("PublicationPdfAr")
  publicationGallery     PublicationGalleryImage[]
  eventMainImages        Event[]                    @relation("EventMainImage")
  eventGallery           EventGalleryImage[]
}

model MediaAltText {
  id           String @id @default(cuid())
  mediaAssetId String
  locale       Locale
  altText      String

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, locale])
}

/// Homepage featured publications slider (manual admin selection + order).
model FeaturedPublication {
  id            String @id @default(cuid())
  publicationId String @unique
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

/// Homepage featured events (max 3 — enforced in service transactions).
model FeaturedEvent {
  id        String @id @default(cuid())
  eventId   String @unique
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

/// Public newsletter sign-ups from the site footer. No admin UI yet.
model NewsletterSubscriber {
  id                   String                      @id @default(cuid())
  /// Normalized lowercase email (unique).
  email                String                      @unique
  status               NewsletterSubscriberStatus  @default(ACTIVE)
  subscribedAt         DateTime                    @default(now())
  /// Explicit consent timestamp captured at subscription.
  consentAt            DateTime                    @default(now())
  notificationSentAt   DateTime?
  /// Last SMTP failure message (no secrets). Cleared on successful send.
  lastNotificationError String?                    @db.Text
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([status, subscribedAt])
}
