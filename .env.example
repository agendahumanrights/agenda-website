# Copy to .env and fill in values. Never commit real secrets.
# The public shell renders without these; database-backed features need DATABASE_URL.

# PostgreSQL — Prisma 7 + Supabase
# Runtime (Prisma Client / @prisma/adapter-pg): transaction pooler (port 6543).
# CLI migrations (prisma.config.ts): session pooler or direct (port 5432) via DIRECT_URL.
# Local Postgres: both can point at the same URL (omit pgbouncer=true).
#
# Supabase example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional dedicated database for integration tests (Vitest skips DB tests if unset)
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:5432/agenda_test?schema=public"

# App
# Canonical public origin (no trailing slash). Must match the browser Origin used in production
# (include www if visitors use https://www.…). Used for metadata + CSRF same-origin checks.
# Production example: https://www.humanrightsagenda.org
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional extra Origins allowed for admin mutations (comma-separated), e.g. apex + www
# AUTH_TRUSTED_ORIGINS="https://humanrightsagenda.org,https://www.humanrightsagenda.org"
# Default UI language when the agenda_locale cookie is missing (code default remains "ar")
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
# Set true/1 on staging/preview to force robots noindex (localhost is auto-noindexed)
# SEO_NOINDEX="true"

# Admin authentication (Phase 2)
# Opaque sessions do not require AUTH_SECRET; reserved for future use.
# AUTH_SECRET=""
ADMIN_SESSION_COOKIE_NAME="agenda_admin_session"
# Comma-separated origins allowed for login/logout CSRF checks (defaults to NEXT_PUBLIC_SITE_URL)
# AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY="false"

# Used only by `npm run admin:create` — never commit real values
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Media storage
# local = filesystem under UPLOAD_DIR (default ./uploads). Dev only — not for ephemeral serverless disks.
# r2 = Cloudflare R2 via S3-compatible API (recommended for production).
# unimplemented = upload/delete throw 501
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
# Optional size / count limits
# UPLOAD_MAX_IMAGE_BYTES="5242880"
# UPLOAD_MAX_PDF_BYTES="20971520"
# Total images per publication/event (main + gallery); gallery max is total − 1
# UPLOAD_MAX_IMAGES_PER_ITEM="10"

# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
# Create an R2 bucket + API token with Object Read & Write. Never commit real secrets.
# R2_ACCOUNT_ID=""
# R2_BUCKET_NAME=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# R2_REGION="auto"
# Public CDN / r2.dev URL for objects (HTTPS, no trailing slash). Not the S3 API endpoint.
# R2_PUBLIC_BASE_URL="https://pub-<id>.r2.dev"

